@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Bán hàng";
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/sales.css" />
}
<div class="container-fluid px-0">
    <input type="hidden" id="currentSellerId" value="@ViewData["CurrentUserId"]" />
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title">Danh sách sản phẩm</h5>
                    <div class="input-group mb-3">
                        <input type="text" id="searchBox" class="form-control" placeholder="Tìm sản phẩm..." />
                        <button class="btn btn-outline-primary" id="btnSearch"><i class="bi bi-search"></i> Tìm</button>
                    </div>
                    <div id="productList" class="row g-3">
                        @foreach (var p in Model)
                        {
                            <div class="col-md-3">
                                <div class="card product-card" data-id="@p.ProductId" data-name="@p.Name" data-price="@p.Price">
                                    <img src="@p.ImageUrl ?? " https: //via.placeholder.com/150"" class="card-img-top" alt="@p.Name">
                                    <div class="card-body text-center">
                                        <h6 class="card-title">@p.Name</h6>
                                        <p class="text-muted mb-1">@p.Price.ToString("N0") đ</p>
                                        <button class="btn btn-sm btn-success btn-add">Thêm</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Hóa đơn hiện tại</h5>
                    
                    <div class="d-flex align-items-center justify-content-between mb-2 position-relative">
                        <div class="invoice-tabs-container flex-grow-1 overflow-hidden">
                            <ul class="nav nav-tabs flex-nowrap" id="invoiceTabs" role="tablist">
                                <li class="nav-item position-relative" role="presentation">
                                    <button class="nav-link active d-flex align-items-center justify-content-between"
                                            id="invoiceNew1-tab" data-bs-toggle="tab"
                                            data-bs-target="#invoiceNew1" type="button" role="tab"
                                            aria-controls="invoiceNew1" aria-selected="true">
                                        <span class="tab-title">Hóa đơn #1</span>
                                    </button>
                                    <span class="tab-close" data-tab="#invoiceNew1" title="Đóng">×</span>
                                </li>
                            </ul>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary ms-2" id="addInvoice">
                            <i class='bx  bx-plus'></i>
                        </button>
                        <div class="dropdown ms-2">
                            <button class="btn btn-light btn-sm dropdown-toggle" id="savedInvoicesBtn"
                                    data-bs-toggle="dropdown" aria-expanded="false" title="Hóa đơn lưu tạm">
                                <i class="bi bi-save"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end"
                                id="savedInvoicesDropdown" aria-labelledby="savedInvoicesBtn">
                            </ul>
                        </div>
                    </div>
                    <div class="tab-content mt-3 flex-grow-1 d-flex flex-column" id="invoiceTabContent">
                        <div class="tab-pane fade show active d-flex flex-column h-100 position-absolute w-100"
                             id="invoiceNew1" role="tabpanel" aria-labelledby="invoiceNew1-tab">

                            <div class="invoice-items flex-grow-1 overflow-auto">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Tên</th>
                                            <th>SL</th>
                                            <th>Giá</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                            <div class="invoice-footer mt-3 pt-3 border-top">
                                <div class="d-flex justify-content-between">
                                    <strong>Tổng cộng:</strong>
                                    <strong class="totalAmount">0 đ</strong>
                                </div>
                                <div class="mt-3 text-end">
                                    <button class="btn btn-outline-secondary btn-sm btn-save-temp">Lưu tạm</button>
                                    <button type="button" class="btn btn-primary btn-sm btn-pay">Thanh toán</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="printPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xem trước hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <iframe id="previewFrame" style="width:100%;height:600px;border:1px solid #ccc;"></iframe>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button id="btnDownloadPdf" class="btn btn-primary">
                    In (Lưu file PDF)
                </button>
            </div>
        </div>
    </div>
</div>
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="successToastBody">
                Thanh toán thành công!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const currentSellerId = '@ViewData["CurrentUserId"]';
    </script>
    <script src="~/js/sales.js"></script>
}

