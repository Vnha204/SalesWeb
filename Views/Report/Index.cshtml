@{
    ViewData["Title"] = "Báo cáo kinh doanh";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/report.css" />
}

<div class="report-container">
    <div>
        <div class="chart-box">
            <h5 class="mb-3">Doanh thu theo ngày (7 ngày gần nhất)</h5>
            <canvas id="revenueByDayChart" height="200"></canvas>
        </div>

        <div class="chart-box">
            <h5 class="mb-3">So sánh Lợi nhuận / Doanh thu / Giá vốn</h5>
            <canvas id="compareChart" height="200"></canvas>
        </div>

        <div class="summary-boxes">
            <div class="summary-box summary-profit">
                <p>Lợi nhuận</p>
                <h4 id="profitValue">₫0</h4>
            </div>
            <div class="summary-box summary-revenue">
                <p>Doanh thu</p>
                <h4 id="revenueValue">₫0</h4>
            </div>
            <div class="summary-box summary-cost">
                <p>Giá vốn</p>
                <h4 id="costValue">₫0</h4>
            </div>
        </div>
    </div>

    <div class="employee-progress">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Top nhân viên bán hàng</h5>
            <select id="monthSelect" class="form-select form-select-sm w-auto">
                <option value="1">Tháng 1</option>
                <option value="2">Tháng 2</option>
                <option value="3">Tháng 3</option>
                <option value="4">Tháng 4</option>
                <option value="5">Tháng 5</option>
                <option value="6">Tháng 6</option>
                <option value="7">Tháng 7</option>
                <option value="8">Tháng 8</option>
                <option value="9">Tháng 9</option>
                <option value="10">Tháng 10</option>
                <option value="11">Tháng 11</option>
                <option value="12">Tháng 12</option>
            </select>
        </div>

        <div id="employeeList">
            <p class="text-muted">Đang tải dữ liệu...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/report.js"></script>
}
