@model SalesWeb.Models.User

@{
    ViewData["Title"] = "Thông tin tài khoản";
    var isManager = Model.role == "manager";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 h-100 text-center">
                <div class="card-body">
                    <img src="~/images/user_default.png" alt="User Avatar"
                         class="rounded-circle border mb-3" width="100" height="100" />
                    <h5 class="fw-bold">@Model.full_name</h5>
                    <p class="text-muted mb-1">@Model.position</p>
                    <span class="badge bg-secondary">
                        @(isManager ? "manager" : "staff")
                    </span>

                    <hr />

                    <p class="mb-1"><strong>Tên đăng nhập:</strong> @Model.username</p>
                    <p class="mb-1"><strong>Ngày tạo:</strong> @Model.created_at.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">Doanh thu theo tháng (@DateTime.Now.Year)</h6>
                </div>
                <div class="card-body">
                    <canvas id="monthlySalesChart" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>

    @if (!isManager)
    {
        <div class="row mt-4">
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">Hoàn thành KPI tháng @DateTime.Now.Month/@DateTime.Now.Year</h6>
                    </div>
                    <div class="card-body text-center">
                        <canvas id="kpiChart" width="160" height="160"></canvas>
                        <p class="mt-3 mb-1 fw-bold" id="kpiPercentText">Đang tải...</p>
                        <p class="text-muted mb-0" id="kpiSalesText"></p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">Nhận xét của quản lý</h6>
                    </div>
                    <div class="card-body">
                        <p id="managerComment" class="text-muted fst-italic">Đang tải nhận xét...</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            await loadMonthlySales();

            if (document.getElementById("kpiChart")) {
                await loadPersonalKPI();
            }
        });

        async function loadMonthlySales() {
            const res = await fetch('/Account/GetMonthlySales');
            const data = await res.json();

            if (data.success) {
                const labels = data.data.map(x => "Tháng " + x.month);
                const values = data.data.map(x => x.total);

                new Chart(document.getElementById('monthlySalesChart').getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            data: values,
                            borderColor: '#007bff',
                            backgroundColor: '#007bff33',
                            tension: 0.3,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) {
                                        return value.toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }

        async function loadPersonalKPI() {
            const res = await fetch('/Account/GetPersonalKPI');
            const data = await res.json();

            if (!data.success) {
                document.getElementById('kpiPercentText').innerText = "Không có dữ liệu KPI";
                document.getElementById('managerComment').innerText = data.message || "Chưa có nhận xét.";
                return;
            }

            const percent = Math.min(data.percent,100);
            const achieved = data.achieved.toLocaleString("vi-VN");
            const target = data.target.toLocaleString("vi-VN");
            const comment = data.evaluation || "Chưa có nhận xét.";

            document.getElementById('kpiPercentText').innerText = percent + "% hoàn thành";
            document.getElementById('kpiSalesText').innerText = `${achieved} / ${target} ₫`;
            document.getElementById('managerComment').innerText = comment;

            const ctx = document.getElementById('kpiChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [percent, 100 - percent],
                        backgroundColor: ['#28a745', '#e9ecef']
                    }]
                },
                options: {
                    cutout: '70%',
                    plugins: { legend: { display: false }, tooltip: { enabled: false } }
                }
            });
        }
    </script>
}
