@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalesWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SalesWeb.styles.css" asp-append-version="true" />
    <link href="https://cdn.boxicons.com/3.0.3/fonts/basic/boxicons.min.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>

<body>
    <div class="d-flex">
        <nav class="sidebar bg-light border-end p-3">
            <div class="container-fluid d-flex flex-column h-100">
                <a class="navbar-brand mb-3 fw-bold" asp-controller="Home" asp-action="Index">SalesWeb</a>

                <ul class="navbar-nav flex-column flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark d-flex align-items-center" asp-controller="Home" asp-action="Index">
                            <i class='bx bx-shopping-bag me-2'></i>Bán hàng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark d-flex align-items-center" asp-controller="Invoice" asp-action="Index">
                            <i class='bx bx-list-ul me-2'></i>Hóa đơn
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark d-flex align-items-center" asp-controller="Products" asp-action="Index">
                            <i class='bx bx-box me-2'></i>Sản phẩm
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark d-flex align-items-center" asp-controller="Report" asp-action="Index">
                            <i class='bxrd  bx-chart-line me-2'></i> </i>Báo cáo
                        </a>
                    </li>

                    @if (userRole == "manager")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark d-flex align-items-center" asp-controller="Manage" asp-action="Index">
                                <i class='bx bx-user me-2'></i>Quản lý
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav mt-auto pt-3 border-top">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class='bx bx-user-circle me-2'></i>
                            @(userName ?? "Tài khoản")
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="accountDropdown">
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="Info">
                                    <i class='bx bx-id-card me-2'></i> Thông tin cá nhân
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger d-flex align-items-center" asp-controller="Login" asp-action="Logout">
                                    <i class='bx bx-log-out me-2'></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark d-flex align-items-center" asp-controller="Settings" asp-action="Settings">
                            <i class='bx bx-cog me-2'></i>Cài đặt
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main role="main" class="flex-grow-1 bg-white">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
